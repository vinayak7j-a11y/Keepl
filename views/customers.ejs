<!DOCTYPE html>
<html>
<head>

<title>Keepl — Customers</title>

<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#2f80ed">

<style>
body{
  font-family:Arial;
  background:#f4f6f8;
  padding:30px;
  margin:0;
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
  flex-wrap:wrap;
  gap:10px;
}

.header-buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

h1{
  margin:0;
  font-size:24px;
}

button{
  background:#2f80ed;
  color:white;
  border:none;
  padding:10px 16px;
  cursor:pointer;
  border-radius:6px;
  font-size:14px;
}

button:hover{
  background:#1c60b3;
}

.logout{
  background:#e74c3c;
}

.logout:hover{
  background:#c0392b;
}

.stats{
  display:flex;
  gap:20px;
  margin-bottom:25px;
  flex-wrap:wrap;
}

.statBox{
  background:white;
  padding:20px;
  border-radius:10px;
  flex:1;
  min-width:160px;
  box-shadow:0 2px 6px rgba(0,0,0,0.05);
  text-align:center;
}

.statBox p{
  font-size:24px;
  font-weight:bold;
  margin-top:10px;
  margin-bottom:0;
}

.statBox h3{
  margin:0;
  font-size:14px;
  color:#555;
}

.card{
  background:white;
  padding:20px;
  border-radius:10px;
  margin-bottom:25px;
  box-shadow:0 2px 6px rgba(0,0,0,0.05);
}

.card-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
  flex-wrap:wrap;
  gap:10px;
}

.card-header h3{
  margin:0;
  font-size:18px;
}

.search-box{
  padding:8px 12px;
  border:1px solid #ddd;
  border-radius:6px;
  font-size:14px;
  width:220px;
}

table{
  width:100%;
  border-collapse:collapse;
}

th,td{
  padding:12px;
  border-bottom:1px solid #eee;
  text-align:left;
  font-size:14px;
}

th{
  background:#fafafa;
  font-weight:600;
  color:#444;
  cursor:pointer;
  user-select:none;
  white-space:nowrap;
}

th:hover{
  background:#f0f0f0;
}

th .sort-arrow{
  font-size:11px;
  margin-left:4px;
  color:#aaa;
}

th.active-sort .sort-arrow{
  color:#2f80ed;
}

.points-badge{
  display:inline-block;
  padding:3px 10px;
  border-radius:20px;
  font-size:13px;
  font-weight:bold;
}

.points-high{
  background:#e8f5e9;
  color:#2e7d32;
}

.points-mid{
  background:#fff3e0;
  color:#e65100;
}

.points-low{
  background:#f5f5f5;
  color:#666;
}

.redeem-tag{
  display:inline-block;
  background:#fce4ec;
  color:#c62828;
  padding:2px 8px;
  border-radius:12px;
  font-size:12px;
  margin:2px;
}

.empty{
  text-align:center;
  padding:40px;
  color:#999;
  font-size:15px;
}

.loading{
  text-align:center;
  padding:40px;
  color:#aaa;
}

.progress-bar-wrap{
  background:#eee;
  border-radius:10px;
  height:6px;
  width:80px;
  display:inline-block;
  vertical-align:middle;
  margin-left:6px;
}

.progress-bar-fill{
  background:#2f80ed;
  height:6px;
  border-radius:10px;
  transition:width 0.3s;
}

.progress-bar-fill.full{
  background:#27ae60;
}

.phone-link{
  color:#2f80ed;
  text-decoration:none;
  font-size:13px;
}

.phone-link:hover{
  text-decoration:underline;
}

#loadingState{
  display:block;
}

#tableWrap{
  display:none;
}

@media(max-width:600px){
  body{ padding:15px; }
  .statBox{ min-width:100%; }
  table{ font-size:12px; }
  th,td{ padding:8px 6px; }
  .search-box{ width:100%; }
  .progress-bar-wrap{ display:none; }
}
</style>

</head>

<body>

<div class="header">
  <h1>👥 <%= shop.name %> — Customers</h1>
  <div class="header-buttons">
    <a href="/dashboard/<%= shop.shopId %>"><button>← Dashboard</button></a>
    <button class="logout" onclick="logout()">Logout</button>
  </div>
</div>

<div class="stats">
  <div class="statBox">
    <h3>Total Customers</h3>
    <p id="statTotal">—</p>
  </div>
  <div class="statBox">
    <h3>Ready to Redeem</h3>
    <p id="statRedeemable">—</p>
  </div>
  <div class="statBox">
    <h3>Total Points Live</h3>
    <p id="statPoints">—</p>
  </div>
  <div class="statBox">
    <h3>Total Redemptions</h3>
    <p id="statRedemptions">—</p>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h3>All Customers</h3>
    <input
      class="search-box"
      type="text"
      id="searchInput"
      placeholder="🔍 Search name or phone..."
      oninput="filterTable()"
    >
  </div>

  <div id="loadingState" class="loading">Loading customers...</div>

  <div id="tableWrap">
    <table id="customerTable">
      <thead>
        <tr>
          <th onclick="sortTable('name')">Name <span class="sort-arrow">↕</span></th>
          <th onclick="sortTable('phone')">Phone <span class="sort-arrow">↕</span></th>
          <th onclick="sortTable('points')">Points <span class="sort-arrow">↕</span></th>
          <th onclick="sortTable('visits')">Visits <span class="sort-arrow">↕</span></th>
          <th onclick="sortTable('totalSpent')">Total Spent <span class="sort-arrow">↕</span></th>
          <th onclick="sortTable('lastVisit')">Last Visit <span class="sort-arrow">↕</span></th>
          <th>Redeem History</th>
        </tr>
      </thead>
      <tbody id="customerBody"></tbody>
    </table>
  </div>
</div>

<script>

const BASE_URL = "https://keepl.onrender.com";
const token = localStorage.getItem("token");
const SHOP_ID = "<%= shop.shopId %>";

if(!token){
  window.location.href = "/";
}

function logout(){
  if(confirm("Logout?")){
    localStorage.clear();
    window.location.href = "/";
  }
}

function safe(text){
  return String(text || "")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}

function formatDate(dateStr){
  if(!dateStr) return "—";
  const d = new Date(dateStr);
  if(isNaN(d)) return "—";
  return d.toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" });
}

/* ── Raw data store for filtering/sorting ── */
let allCustomers = [];
let sortKey = "points";
let sortAsc = false;

/* ── Fetch customers ── */
async function loadCustomers(){
  try{
    const res = await fetch(`${BASE_URL}/api/customers/shop/${SHOP_ID}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if(res.status === 401){
      localStorage.clear();
      window.location.href = "/";
      return;
    }

    if(!res.ok) throw new Error("Failed to fetch");

    const data = await res.json();
    allCustomers = data;

    updateStats(data);
    renderTable(data);

    document.getElementById("loadingState").style.display = "none";
    document.getElementById("tableWrap").style.display = "block";

  }catch(err){
    console.error("Load customers error:", err);
    document.getElementById("loadingState").innerText = "Failed to load customers. Please refresh.";
  }
}

/* ── Stats summary ── */
function updateStats(data){
  const total       = data.length;
  const redeemable  = data.filter(c => c.points >= 100).length;
  const totalPoints = data.reduce((s,c) => s + (c.points || 0), 0);
  const totalRedeem = data.reduce((s,c) => s + (c.redeemCount || 0), 0);

  document.getElementById("statTotal").innerText       = total;
  document.getElementById("statRedeemable").innerText  = redeemable;
  document.getElementById("statPoints").innerText      = totalPoints.toLocaleString("en-IN");
  document.getElementById("statRedemptions").innerText = totalRedeem;
}

/* ── Render table ── */
function renderTable(data){
  const tbody = document.getElementById("customerBody");

  if(!data.length){
    tbody.innerHTML = `<tr><td colspan="7" class="empty">No customers yet</td></tr>`;
    return;
  }

  tbody.innerHTML = data.map(c => {

    /* Points badge */
    let badgeClass = "points-low";
    if(c.points >= 100) badgeClass = "points-high";
    else if(c.points >= 50) badgeClass = "points-mid";

    /* Progress bar */
    const pct = Math.min(100, Math.round((c.points / 100) * 100));
    const barClass = pct >= 100 ? "full" : "";

    /* Redeem history */
    let redeemHtml = "—";
    if(c.redeemHistory && c.redeemHistory.length){
      redeemHtml = c.redeemHistory
        .slice(0, 3)
        .map(r => `<span class="redeem-tag">🎁 ${formatDate(r.date)}</span>`)
        .join("");
      if(c.redeemHistory.length > 3){
        redeemHtml += `<span class="redeem-tag">+${c.redeemHistory.length - 3} more</span>`;
      }
    }

    return `
    <tr>
      <td><strong>${safe(c.name)}</strong></td>
      <td>
        <a class="phone-link" href="https://wa.me/91${safe(c.phone)}" target="_blank">
          ${safe(c.phone)}
        </a>
      </td>
      <td>
        <span class="points-badge ${badgeClass}">${c.points} pts</span>
        <span class="progress-bar-wrap">
          <span class="progress-bar-fill ${barClass}" style="width:${pct}%"></span>
        </span>
      </td>
      <td>${c.visits}</td>
      <td>₹${(c.totalSpent || 0).toLocaleString("en-IN")}</td>
      <td>${formatDate(c.lastVisit)}</td>
      <td>${redeemHtml}</td>
    </tr>`;
  }).join("");
}

/* ── Search filter ── */
function filterTable(){
  const q = document.getElementById("searchInput").value.toLowerCase();
  const filtered = allCustomers.filter(c =>
    (c.name || "").toLowerCase().includes(q) ||
    (c.phone || "").includes(q)
  );
  renderTable(sortData(filtered));
}

/* ── Sort ── */
function sortTable(key){
  if(sortKey === key){
    sortAsc = !sortAsc;
  } else {
    sortKey = key;
    sortAsc = false;
  }

  /* Update header arrows */
  document.querySelectorAll("th").forEach(th => th.classList.remove("active-sort"));
  event.currentTarget.classList.add("active-sort");

  const q = document.getElementById("searchInput").value.toLowerCase();
  const filtered = allCustomers.filter(c =>
    (c.name || "").toLowerCase().includes(q) ||
    (c.phone || "").includes(q)
  );
  renderTable(sortData(filtered));
}

function sortData(data){
  return [...data].sort((a,b) => {
    let valA = a[sortKey];
    let valB = b[sortKey];

    if(sortKey === "name" || sortKey === "phone"){
      valA = (valA || "").toLowerCase();
      valB = (valB || "").toLowerCase();
      return sortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
    }

    if(sortKey === "lastVisit"){
      valA = valA ? new Date(valA).getTime() : 0;
      valB = valB ? new Date(valB).getTime() : 0;
    }

    valA = valA || 0;
    valB = valB || 0;
    return sortAsc ? valA - valB : valB - valA;
  });
}

loadCustomers();

</script>

</body>
</html>
