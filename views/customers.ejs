<!DOCTYPE html>
<html>
<head>

<title>Keepl — Customers</title>

<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#FF6B00">

<link rel="stylesheet" href="/keepl.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

<style>
body {
  font-family: Arial, sans-serif;
  background: var(--k-bg);
  margin: 0;
  padding: 0;
  color: var(--k-ink);
}

.k-page {
  max-width: 1000px;
  margin: 0 auto;
  padding: 24px 20px 40px;
}

/* ── Table ── */
table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px 14px;
  border-bottom: 0.5px solid var(--k-border);
  text-align: left;
  font-size: 14px;
}

th {
  background: var(--k-bg);
  font-weight: 500;
  font-size: 13px;
  color: var(--k-ink-tertiary);
  cursor: pointer;
  user-select: none;
  white-space: nowrap;
}

th:hover {
  color: var(--k-saffron);
}

th .sort-arrow {
  font-size: 11px;
  margin-left: 4px;
  color: var(--k-border);
}

th.active-sort .sort-arrow {
  color: var(--k-saffron);
}

td {
  color: var(--k-ink);
}

/* ── Search ── */
.search-box {
  padding: 9px 14px;
  border: 1.5px solid var(--k-border);
  border-radius: var(--k-r-md);
  font-size: 14px;
  width: 240px;
  font-family: inherit;
  color: var(--k-ink);
  background: var(--k-surface);
  outline: none;
  transition: border-color 0.15s;
}

.search-box:focus {
  border-color: var(--k-saffron);
  box-shadow: 0 0 0 3px rgba(255,107,0,0.08);
}

/* ── Points badge ── */
.points-badge {
  display: inline-flex;
  align-items: center;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

.points-high {
  background: var(--k-teal-lt);
  color: var(--k-teal-dk);
}

.points-mid {
  background: var(--k-saffron-lt);
  color: var(--k-saffron-dk);
}

.points-low {
  background: #EEEEF5;
  color: var(--k-ink-tertiary);
}

/* ── Redeem tag ── */
.redeem-tag {
  display: inline-block;
  background: var(--k-teal-lt);
  color: var(--k-teal-dk);
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 12px;
  margin: 2px;
}

/* ── Progress bar ── */
.progress-bar-wrap {
  background: var(--k-border);
  border-radius: 10px;
  height: 6px;
  width: 80px;
  display: inline-block;
  vertical-align: middle;
  margin-left: 8px;
}

.progress-bar-fill {
  background: var(--k-saffron);
  height: 6px;
  border-radius: 10px;
  transition: width 0.3s;
}

.progress-bar-fill.full {
  background: var(--k-teal);
}

/* ── Phone link ── */
.phone-link {
  color: var(--k-teal);
  text-decoration: none;
  font-size: 13px;
}

.phone-link:hover {
  text-decoration: underline;
}

/* ── States ── */
.empty {
  text-align: center;
  padding: 40px;
  color: var(--k-ink-tertiary);
  font-size: 14px;
}

.loading {
  text-align: center;
  padding: 40px;
  color: var(--k-ink-tertiary);
  font-size: 14px;
}

#loadingState { display: block; }
#tableWrap    { display: none; }

/* ── Card header ── */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  flex-wrap: wrap;
  gap: 10px;
}

.card-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
  color: var(--k-ink);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ── Back link ── */
.back {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  color: var(--k-ink-tertiary);
  text-decoration: none;
  padding: 6px 12px;
  border: 0.5px solid var(--k-border);
  border-radius: var(--k-r-sm);
  background: var(--k-surface);
  transition: border-color 0.15s;
}

.back:hover {
  border-color: var(--k-saffron);
  color: var(--k-saffron);
}

@media (max-width: 600px) {
  .k-page { padding: 16px; }
  table { font-size: 12px; }
  th, td { padding: 8px 6px; }
  .search-box { width: 100%; }
  .progress-bar-wrap { display: none; }
  .k-stat-grid { grid-template-columns: 1fr 1fr; }
}
</style>

</head>

<body>

<!-- Nav -->
<nav class="k-nav">
  <div class="k-nav-logo">
    <div class="k-nav-logo-icon"><i class="ti ti-bolt"></i></div>
    <div class="k-nav-logo-text">keep<span>l</span></div>
  </div>
  <div class="k-nav-actions">
    <a class="back" href="/dashboard/<%= shop.shopId %>">
      <i class="ti ti-arrow-left"></i> Dashboard
    </a>
    <button class="k-btn k-btn-danger k-btn-sm" onclick="logout()">
      <i class="ti ti-logout"></i> Logout
    </button>
  </div>
</nav>

<div class="k-page">

  <!-- Heading -->
  <div style="margin-bottom:24px;">
    <h2 style="font-size:22px;font-weight:500;color:var(--k-ink);margin:0 0 4px;">
      <i class="ti ti-users" style="color:var(--k-saffron);vertical-align:-2px;margin-right:6px;"></i>
      <%= shop.name %> — Customers
    </h2>
    <p style="font-size:14px;color:var(--k-ink-tertiary);margin:0;">
      All customers who have scanned your QR
    </p>
  </div>

  <!-- Stat cards -->
  <div class="k-stat-grid">
    <div class="k-stat-card k-stat-saffron">
      <i class="ti ti-users k-stat-icon"></i>
      <div class="k-stat-label">Total Customers</div>
      <div class="k-stat-num" id="statTotal">—</div>
    </div>
    <div class="k-stat-card k-stat-teal">
      <i class="ti ti-gift k-stat-icon"></i>
      <div class="k-stat-label">Ready to Redeem</div>
      <div class="k-stat-num" id="statRedeemable">—</div>
    </div>
    <div class="k-stat-card k-stat-dark">
      <i class="ti ti-bolt k-stat-icon"></i>
      <div class="k-stat-label">Total Points Live</div>
      <div class="k-stat-num" id="statPoints">—</div>
    </div>
    <div class="k-stat-card" style="background:var(--k-gold-lt);color:#7B5E00;">
      <i class="ti ti-repeat k-stat-icon" style="color:#7B5E00;"></i>
      <div class="k-stat-label" style="color:#7B5E00;">Total Redemptions</div>
      <div class="k-stat-num" style="color:#7B5E00;" id="statRedemptions">—</div>
    </div>
  </div>

  <!-- Customer table card -->
  <div class="k-card">
    <div class="card-header">
      <h3>
        <i class="ti ti-table" style="color:var(--k-saffron);"></i>
        All Customers
      </h3>
      <input
        class="search-box"
        type="text"
        id="searchInput"
        placeholder="Search name or phone..."
        oninput="filterTable()"
      >
    </div>

    <div id="loadingState" class="loading">
      <i class="ti ti-loader" style="font-size:20px;"></i><br>Loading customers...
    </div>

    <div id="tableWrap">
      <table id="customerTable">
        <thead>
          <tr>
            <th onclick="sortTable('name')">Name <span class="sort-arrow">↕</span></th>
            <th onclick="sortTable('phone')">Phone <span class="sort-arrow">↕</span></th>
            <th onclick="sortTable('points')">Points <span class="sort-arrow">↕</span></th>
            <th onclick="sortTable('visits')">Visits <span class="sort-arrow">↕</span></th>
            <th onclick="sortTable('totalSpent')">Total Spent <span class="sort-arrow">↕</span></th>
            <th onclick="sortTable('lastVisit')">Last Visit <span class="sort-arrow">↕</span></th>
            <th>Redeem History</th>
          </tr>
        </thead>
        <tbody id="customerBody"></tbody>
      </table>
    </div>
  </div>

</div>

<script>

const BASE_URL = "https://keepl.onrender.com";
const token = localStorage.getItem("token");
const SHOP_ID = "<%= shop.shopId %>";
const REWARD_THRESHOLD = <%= shop.rewardThreshold || 100 %>;

if(!token){
  window.location.href = "/";
}

function logout(){
  if(confirm("Logout?")){
    localStorage.clear();
    window.location.href = "/";
  }
}

function safe(text){
  return String(text || "")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}

function formatDate(dateStr){
  if(!dateStr) return "—";
  const d = new Date(dateStr);
  if(isNaN(d)) return "—";
  return d.toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" });
}

/* ── Raw data store for filtering/sorting ── */
let allCustomers = [];
let sortKey = "points";
let sortAsc = false;

/* ── Fetch customers ── */
async function loadCustomers(){
  try{
    const res = await fetch(`${BASE_URL}/api/customers/shop/${SHOP_ID}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if(res.status === 401){
      localStorage.clear();
      window.location.href = "/";
      return;
    }

    if(!res.ok) throw new Error("Failed to fetch");

    const data = await res.json();
    allCustomers = data;

    updateStats(data);
    renderTable(data);

    document.getElementById("loadingState").style.display = "none";
    document.getElementById("tableWrap").style.display = "block";

  }catch(err){
    console.error("Load customers error:", err);
    document.getElementById("loadingState").innerText = "Failed to load customers. Please refresh.";
  }
}

/* ── Stats summary ── */
function updateStats(data){
  const total       = data.length;
  const redeemable  = data.filter(c => c.points >= REWARD_THRESHOLD).length;
  const totalPoints = data.reduce((s,c) => s + (c.points || 0), 0);
  const totalRedeem = data.reduce((s,c) => s + (c.redeemCount || 0), 0);

  document.getElementById("statTotal").innerText       = total;
  document.getElementById("statRedeemable").innerText  = redeemable;
  document.getElementById("statPoints").innerText      = totalPoints.toLocaleString("en-IN");
  document.getElementById("statRedemptions").innerText = totalRedeem;
}

/* ── Render table ── */
function renderTable(data){
  const tbody = document.getElementById("customerBody");

  if(!data.length){
    tbody.innerHTML = `<tr><td colspan="7" class="empty">No customers yet</td></tr>`;
    return;
  }

  tbody.innerHTML = data.map(c => {

    /* Points badge */
    let badgeClass = "points-low";
    if(c.points >= REWARD_THRESHOLD) badgeClass = "points-high";
    else if(c.points >= REWARD_THRESHOLD * 0.5) badgeClass = "points-mid";

    /* Progress bar */
    const pct = Math.min(100, Math.round((c.points / REWARD_THRESHOLD) * 100));
    const barClass = pct >= 100 ? "full" : "";

    /* Redeem history */
    let redeemHtml = "—";
    if(c.redeemHistory && c.redeemHistory.length){
      redeemHtml = c.redeemHistory
        .slice(0, 3)
        .map(r => `<span class="redeem-tag">🎁 ${formatDate(r.date)}</span>`)
        .join("");
      if(c.redeemHistory.length > 3){
        redeemHtml += `<span class="redeem-tag">+${c.redeemHistory.length - 3} more</span>`;
      }
    }

    return `
    <tr>
      <td>
        <div style="display:flex;align-items:center;gap:10px;">
          <div style="width:34px;height:34px;border-radius:10px;background:var(--k-saffron-lt);color:var(--k-saffron-dk);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;flex-shrink:0;">
            ${safe(c.name).split(" ").map(w=>w[0]).join("").toUpperCase().slice(0,2)}
          </div>
          <strong>${safe(c.name)}</strong>
        </div>
      </td>
      <td>
        <a class="phone-link" href="https://wa.me/91${safe(c.phone)}" target="_blank">
          ${safe(c.phone)}
        </a>
      </td>
      <td>
        <span class="points-badge ${badgeClass}">${c.points} pts</span>
        <span class="progress-bar-wrap">
          <span class="progress-bar-fill ${barClass}" style="width:${pct}%"></span>
        </span>
      </td>
      <td style="color:var(--k-ink-secondary);">${c.visits}</td>
      <td style="color:var(--k-ink-secondary);">₹${(c.totalSpent || 0).toLocaleString("en-IN")}</td>
      <td style="color:var(--k-ink-tertiary);font-size:13px;">${formatDate(c.lastVisit)}</td>
      <td>${redeemHtml}</td>
    </tr>`;
  }).join("");
}

/* ── Search filter ── */
function filterTable(){
  const q = document.getElementById("searchInput").value.toLowerCase();
  const filtered = allCustomers.filter(c =>
    (c.name || "").toLowerCase().includes(q) ||
    (c.phone || "").includes(q)
  );
  renderTable(sortData(filtered));
}

/* ── Sort ── */
function sortTable(key){
  if(sortKey === key){
    sortAsc = !sortAsc;
  } else {
    sortKey = key;
    sortAsc = false;
  }

  /* Update header arrows */
  document.querySelectorAll("th").forEach(th => th.classList.remove("active-sort"));
  event.currentTarget.classList.add("active-sort");

  const q = document.getElementById("searchInput").value.toLowerCase();
  const filtered = allCustomers.filter(c =>
    (c.name || "").toLowerCase().includes(q) ||
    (c.phone || "").includes(q)
  );
  renderTable(sortData(filtered));
}

function sortData(data){
  return [...data].sort((a,b) => {
    let valA = a[sortKey];
    let valB = b[sortKey];

    if(sortKey === "name" || sortKey === "phone"){
      valA = (valA || "").toLowerCase();
      valB = (valB || "").toLowerCase();
      return sortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
    }

    if(sortKey === "lastVisit"){
      valA = valA ? new Date(valA).getTime() : 0;
      valB = valB ? new Date(valB).getTime() : 0;
    }

    valA = valA || 0;
    valB = valB || 0;
    return sortAsc ? valA - valB : valB - valA;
  });
}

loadCustomers();

</script>

</body>
</html>
