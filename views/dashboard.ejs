/* =========================
   GIVE POINTS + WHATSAPP
========================= */

async function givePoints(phone, queueId, customerName, btn){

  if(btn.disabled) return;

  const amountInput = document.getElementById(`amount-${phone}`);
  const amount = amountInput?.value;
  const snapshotAmount = amount;
  activeInputPhone = phone;
  const msg = document.getElementById(`msg-${phone}`);

  if(!snapshotAmount || snapshotAmount <= 0){
    msg.innerHTML = "<span class='error'>Enter a valid amount</span>";
    return;
  }

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{

    const res = await fetch(`${BASE_URL}/api/transactions`,{
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({
        phone,
        shopId,
        billAmount: Number(snapshotAmount),
        queueId
      })
    });

    const data = await res.json();

    if(res.ok){

      const earned = data.pointsEarned;
      const total  = data.totalPoints;
      const spent  = snapshotAmount;

      msg.innerHTML = `
        <span class="success">+${earned} pts ✓</span>
        <button
          class="k-wa-btn"
          style="margin-left:6px;"
          onclick="sendWhatsApp('${phone}',${JSON.stringify(customerName)},${earned},${total},${spent})">
          📲 WhatsApp
        </button>
        <button
          class="k-btn k-btn-sm"
          style="margin-left:6px;background:var(--k-danger-lt);color:var(--k-danger);border:none;"
          onclick="undoPoints('${phone}', this)">
          ↩ Undo
        </button>`;

      sendWhatsApp(phone, customerName, earned, total, spent);

      recentlyProcessed.add(phone);
      lastTransactionTime = Date.now();

      amountInput.value = "";
      delete inputCache[phone];
      activeInputPhone = null;

      setTimeout(fetchQueue, 1000);

    }else{
      msg.innerHTML = `<span class='error'>${data.message || "Error"}</span>`;
    }

  }catch(err){
    console.error("Give points error:", err);
    msg.innerHTML = "<span class='error'>Server error</span>";
    activeInputPhone = null;
    lastTransactionTime = 0;
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="ti ti-bolt"></i> Give';
}

/* =========================
   REDEEM POINTS + WHATSAPP
========================= */

async function redeemPoints(phone, queueId, customerName, currentPoints, btn){

  if(btn.disabled) return;

  const confirmed = confirm(
    `Redeem ${REWARD_THRESHOLD} points for ${customerName}?\nThey have ${currentPoints} pts. Remaining after: ${currentPoints - REWARD_THRESHOLD} pts.`
  );
  if(!confirmed) return;

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";
  const msg = document.getElementById(`redeem-msg-${phone}`);

  try{

    const res = await fetch(`${BASE_URL}/api/redeem`,{
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ phone, shopId, points: REWARD_THRESHOLD, queueId })
    });

    const data = await res.json();

    if(res.ok){
      msg.innerHTML = `<span class="success">Redeemed ✓</span>
        <button class="k-wa-btn" style="margin-left:6px;"
          onclick="sendWhatsAppRedeem('${phone}',${JSON.stringify(customerName)},${REWARD_THRESHOLD},${data.remainingPoints})">
          📲 WhatsApp
        </button>`;

      sendWhatsAppRedeem(phone, customerName, REWARD_THRESHOLD, data.remainingPoints);

      recentlyProcessed.add(phone);
      lastTransactionTime = Date.now();

      setTimeout(fetchQueue, 1000);

    }else{
      msg.innerHTML = `<span class="error">${data.message || "Error"}</span>`;
      btn.disabled = false;
      btn.innerHTML = '<i class="ti ti-gift"></i> Redeem';
    }

  }catch(err){
    console.error("Redeem error:", err);
    msg.innerHTML = "<span class='error'>Server error</span>";
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-gift"></i> Redeem';
  }
}

/* =========================
   AUTO REFRESH
========================= */
async function loadQR(){
  const img = document.getElementById('shopQRImg');
  const missing = document.getElementById('qrMissing');

  const cached = localStorage.getItem('qrCode');
  if(cached){
    img.src = cached;
    img.style.display = 'block';
    return;
  }

  try{
    const shopId = "<%= shop.shopId %>";
    const res = await fetch(`${BASE_URL}/api/shops/${shopId}/qr`, {
      headers: { "Authorization": `Bearer ${token}` }
    });
    if(!res.ok) throw new Error("QR fetch failed");
    const data = await res.json();
    if(data.qrCode){
      localStorage.setItem('qrCode', data.qrCode);
      img.src = data.qrCode;
      img.style.display = 'block';
    } else {
      missing.style.display = 'block';
    }
  }catch(err){
    console.error("QR load error:", err);
    missing.style.display = 'block';
  }
}

/* =========================
   MANUAL CUSTOMER SEARCH
========================= */

async function searchCustomer(query) {
  const resultDiv = document.getElementById("customerSearchResult");

  if (!query || query.length < 2) {
    resultDiv.innerHTML = "";
    return;
  }

  try {
    const shopId = "<%= shop.shopId %>";
    const res = await fetch(`${BASE_URL}/api/customers/search/${shopId}?q=${encodeURIComponent(query)}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if (!res.ok) return;

    const customers = await res.json();
    const matched = customers.filter(c => !dismissedPhones.has(c.phone));

    if (!matched.length) {
      resultDiv.innerHTML = `<p style="font-size:13px;color:var(--k-ink-tertiary);margin-top:8px;">No customers found</p>`;
      return;
    }

    resultDiv.innerHTML = matched.map(c => {
      const initials = c.name ? c.name.split(" ").map(w => w[0]).join("").toUpperCase().slice(0, 2) : "?";
      return `
      <div id="search-row-${c.phone}" style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:0.5px solid var(--k-border);">
        <div style="width:40px;height:40px;border-radius:10px;background:var(--k-saffron-lt);color:var(--k-saffron-dk);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;flex-shrink:0;">
          ${initials}
        </div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">${safe(c.name)}</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">${c.phone} · ${c.points} pts at your shop</div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <input type="number" id="search-amount-${c.phone}" placeholder="₹ amount" min="1"
            style="width:100px;padding:7px 10px;border:1.5px solid var(--k-border);border-radius:var(--k-r-sm);font-size:13px;font-family:inherit;outline:none;"
            onfocus="activeInputPhone='${c.phone}'"
            onblur="setTimeout(()=>{ activeInputPhone=null; }, 300)">
          <button class="k-btn k-btn-primary k-btn-sm" data-name="${c.name}"
            onclick="givePointsManual('${c.phone}', this.dataset.name, this)">
            <i class="ti ti-bolt"></i> Give
          </button>
          <button class="k-btn k-btn-sm"
            style="background:var(--k-bg);color:var(--k-ink-tertiary);border:0.5px solid var(--k-border);"
            onclick="dismissedPhones.add('${c.phone}'); document.getElementById('search-row-${c.phone}').remove()">
            <i class="ti ti-x"></i>
          </button>
        </div>
      </div>`;
    }).join("");

  } catch (err) {
    console.error("Search error:", err);
  }
}
/* =========================
   GIVE POINTS MANUAL (no queue)
========================= */

async function givePointsManual(phone, customerName, btn){
  if(btn.disabled) return;

  const amountInput = document.getElementById(`search-amount-${phone}`);
  const snapshotAmount = amountInput?.value;
  activeInputPhone = phone;

  if(!snapshotAmount || snapshotAmount <= 0){
    alert("Enter a valid bill amount");
    activeInputPhone = null;
    return;
  }

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{
    const res = await fetch(`${BASE_URL}/api/transactions`, {
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({
        phone,
        shopId,
        billAmount: Number(snapshotAmount)
      })
    });

    const data = await res.json();

    if(res.ok){
      const earned = data.pointsEarned;
      const total  = data.totalPoints;

      sendWhatsApp(phone, customerName, earned, total, snapshotAmount);

      amountInput.value = "";
      activeInputPhone = null;

      const q = document.getElementById("customerSearchInput").value;
      searchCustomer(q);
      setTimeout(forceRefreshQueue, 800);

      const row = btn.closest('div[style*="border-bottom"]');
      if(row){
        const msg = document.createElement('span');
        msg.style.cssText = 'font-size:12px;color:var(--k-teal);font-weight:500;margin-left:8px;';
        msg.innerText = '+' + earned + ' pts ✓';
        btn.parentElement.appendChild(msg);
        setTimeout(() => msg.remove(), 3000);
      }

    }else{
      alert(data.message || "Failed to give points");
    }

  }catch(err){
    console.error("Manual give error:", err);
    alert("Server error");
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="ti ti-bolt"></i> Give';
  activeInputPhone = null;
}

/* =========================
   ONBOARDING CHECKLIST
========================= */

async function loadOnboardingChecklist(){
  if(localStorage.getItem('keepl_onboarding_dismissed') === '1') return;

  try{
    const shopId = "<%= shop.shopId %>";
    const res = await fetch(`${BASE_URL}/dashboard/onboarding-status/${shopId}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });
    if(!res.ok) return;
    const s = await res.json();

    if(s.hasQR && s.hasFirstCustomer && s.hasFirstPoints){
      localStorage.setItem('keepl_onboarding_dismissed', '1');
      return;
    }

    function markDone(stepId){
      const icon = document.getElementById(stepId + '-icon');
      const row  = document.getElementById(stepId);
      if(!icon || !row) return;
      icon.innerHTML = '✓';
      icon.style.cssText += 'border-color:var(--k-teal);background:var(--k-teal-lt);color:var(--k-teal-dk);font-size:14px;';
      row.style.opacity = '0.6';
    }

    if(s.hasQR)             markDone('step1');
    if(s.hasFirstCustomer)  markDone('step2');
    if(s.hasFirstPoints)    markDone('step3');

    document.getElementById('onboardingChecklist').style.display = 'block';

  }catch(err){
    console.error('Onboarding check error:', err);
  }
}

function dismissChecklist(){
  localStorage.setItem('keepl_onboarding_dismissed', '1');
  document.getElementById('onboardingChecklist').style.display = 'none';
}

loadOnboardingChecklist();
loadQR();


/* =========================
   UNDO LAST TRANSACTION
========================= */

async function undoPoints(phone, btn){
  if(!confirm("Undo last points given to this customer?")) return;

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{
    const res = await fetch(`${BASE_URL}/api/transactions/undo`, {
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ phone, shopId })
    });

    const data = await res.json();

    if(res.ok){
      const msg = document.getElementById(`msg-${phone}`);
      if(msg) msg.innerHTML = `<span style="color:var(--k-danger);font-size:13px;">↩ Undone — ${data.pointsRemoved} pts removed</span>`;
      setTimeout(fetchQueue, 1000);
    } else {
      alert(data.message || "Could not undo");
      btn.disabled = false;
      btn.innerText = "↩ Undo";
    }

  }catch(err){
    console.error("Undo error:", err);
    alert("Server error");
    btn.disabled = false;
    btn.innerText = "↩ Undo";
  }
}

setInterval(fetchLiveStats, 30000);

setInterval(()=>{
  if(!document.hidden && !activeInputPhone){
    fetchQueue();
  }
}, 3000);

/* =========================
   PWA INSTALL
========================= */

let deferredPrompt;

if(/iPhone|iPad|iPod/.test(navigator.userAgent) && !window.navigator.standalone){
  const iosHint = document.createElement('div');
  iosHint.style.cssText = 'font-size:12px;color:var(--k-ink-tertiary);text-align:center;padding:8px;';
  iosHint.innerHTML = '📲 iPhone? Tap Share → <strong>Add to Home Screen</strong>';
  document.getElementById('installBtn').parentElement.appendChild(iosHint);
}

window.addEventListener("beforeinstallprompt",(e)=>{
  e.preventDefault();
  deferredPrompt = e;

  const btn = document.getElementById("installBtn");
  btn.style.display = "inline-flex";

  btn.onclick = async ()=>{
    deferredPrompt.prompt();
    const choice = await deferredPrompt.userChoice;
    if(choice.outcome === "accepted") btn.style.display = "none";
  };
});


/* =========================
   SUPPORT PANEL
========================= */

function toggleSupport(){
  const topics = document.getElementById("supportTopics");
  const chevron = document.getElementById("supportChevron");
  const isHidden = topics.style.display === "none";
  topics.style.display = isHidden ? "block" : "none";
  chevron.style.transform = isHidden ? "rotate(180deg)" : "";
}

function toggleTopic(el){
  el.classList.toggle("open");
}

/* =========================
   SERVICE WORKER
========================= */

// service worker disabled
function openQRModal(){
  document.getElementById("qrModal").style.display = "flex";
}

function closeQRModal(){
  document.getElementById("qrModal").style.display = "none";
} 

