/* =========================
   SAVE REWARD THRESHOLD
========================= */

async function saveRewardThreshold(){
  const input = document.getElementById("thresholdInput");
  const msg = document.getElementById("thresholdMsg");
  const value = parseInt(input.value);

  msg.innerHTML = "";

  if(!value || value < 10){
    msg.innerHTML = "<span class='error'>Please enter at least 10 points</span>";
    return;
  }

  try{
    const shopId = "<%= shop.shopId %>";

    const res = await fetch(`${BASE_URL}/api/shops/${shopId}/reward-threshold`, {
      method: "PATCH",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ rewardThreshold: value })
    });

    const data = await res.json();

    if(res.ok){
      msg.innerHTML = `<span class="success">✓ Saved!</span>`;
      document.getElementById('thresholdDisplay').innerText = data.rewardThreshold;
      REWARD_THRESHOLD = data.rewardThreshold;
      setTimeout(() => { document.getElementById('rewardSettingsExpanded').style.display = 'none'; }, 1000);
    } else {
      msg.innerHTML = `<span class="error">${data.message || "Failed to save"}</span>`;
    }

  }catch(err){
    console.error("Save threshold error:", err);
    msg.innerHTML = "<span class='error'>Server error. Try again.</span>";
  }
}


