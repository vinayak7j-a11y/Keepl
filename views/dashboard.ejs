<!DOCTYPE html>
<html>
<head>

<title>Keepl Dashboard</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#2f80ed">

<style>
body{
font-family:Arial;
background:#f4f6f8;
padding:30px;
margin:0;
}

.header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:25px;
flex-wrap:wrap;
gap:10px;
}

.header-buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
}

h1{
margin:0;
font-size:24px;
}

button{
background:#2f80ed;
color:white;
border:none;
padding:10px 16px;
cursor:pointer;
border-radius:6px;
font-size:14px;
}

button:hover{
background:#1c60b3;
}

.logout{
background:#e74c3c;
}

.logout:hover{
background:#c0392b;
}

/* ✅ WhatsApp button style */
.wa-btn{
background:#25d366;
color:white;
border:none;
padding:8px 12px;
cursor:pointer;
border-radius:6px;
font-size:13px;
margin-left:6px;
}

.wa-btn:hover{
background:#1da851;
}

.stats{
display:flex;
gap:20px;
margin-bottom:25px;
flex-wrap:wrap;
}

.statBox{
background:white;
padding:20px;
border-radius:10px;
flex:1;
min-width:200px;
box-shadow:0 2px 6px rgba(0,0,0,0.05);
text-align:center;
}

.statBox p{
font-size:24px;
font-weight:bold;
margin-top:10px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
margin-bottom:25px;
box-shadow:0 2px 6px rgba(0,0,0,0.05);
}

table{
width:100%;
border-collapse:collapse;
}

th,td{
padding:12px;
border-bottom:1px solid #eee;
text-align:left;
}

th{
background:#fafafa;
}

.qrSection{
text-align:center;
}

.empty{
text-align:center;
padding:20px;
color:#777;
}

input[type="number"]{
padding:8px;
border-radius:6px;
border:1px solid #ddd;
width:110px;
font-size:14px;
}

.success{
color:green;
font-size:13px;
margin-top:5px;
}

.error{
color:red;
font-size:13px;
margin-top:5px;
}

#installBtn{
display:none;
}

@media(max-width:600px){
body{ padding:15px; }
.statBox{ min-width:100%; }
table{ font-size:13px; }
}
</style>

</head>

<body>

<div class="header">
<h1><%= shop.name %> Dashboard</h1>

<div class="header-buttons">
<button id="installBtn">Install App</button>

<a href="/poster/<%= shop.shopId %>">
<button>Download QR Poster</button>
</a>

<button class="logout" onclick="logout()">Logout</button>
</div>
</div>

<div class="stats">
<div class="statBox">
<h3>Customers Today</h3>
<p><%= customersToday %></p>
</div>

<div class="statBox">
<h3>Points Given Today</h3>
<p><%= pointsToday %></p>
</div>

<div class="statBox">
<h3>Total Waiting</h3>
<p id="waitingCount"><%= customers.length %></p>
</div>
</div>

<div class="card">
<h3>Customers Waiting</h3>
<table id="queueTable"></table>
</div>

<div class="card qrSection">
<h3>Your Shop QR</h3>

<% if(shop.qrCode){ %>
<img
  src="<%= shop.qrCode %>"
  width="200"
  style="border-radius:10px;padding:10px;background:white;box-shadow:0 4px 10px rgba(0,0,0,0.08);">
<% } else { %>
<p style="color:#e74c3c;">QR not generated. Please logout and login again.</p>
<% } %>

<p>Customers scan this QR to earn rewards</p>
</div>

<script>

/* =========================
SESSION CHECK
========================= */
const BASE_URL = "https://keepl.onrender.com";
const token = localStorage.getItem("token");
const shopIdLocal = localStorage.getItem("shopId");

// ✅ Pass shop name from EJS to JS for WhatsApp message
const SHOP_NAME = "<%= shop.name %>";

if(!token || !shopIdLocal){
  window.location.href="/";
}

/* =========================
STATE MANAGEMENT
========================= */

let isFetching = false;
let activeInputPhone = null;
let inputCache = {};

/* =========================
LOGOUT
========================= */

function logout(){
  if(confirm("Logout?")){
    localStorage.clear();
    window.location.href="/";
  }
}

/* =========================
SAFE TEXT
========================= */

function safe(text){
  return String(text)
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}

/* =========================
WHATSAPP MESSAGE SENDER
========================= */

function sendWhatsApp(phone, customerName, pointsEarned, totalPoints){
  // ✅ Build pre-filled WhatsApp message
  const message =
    `Hi ${customerName}! 🎉\n\n` +
    `You just earned *${pointsEarned} points* at *${SHOP_NAME}*.\n\n` +
    `Your total points: *${totalPoints} pts*\n\n` +
    `🎁 Collect *100 points* to redeem a free reward!\n\n` +
    `Keep shopping with us 😊\n` +
    `– ${SHOP_NAME} via Keepl`;

  // ✅ Indian numbers need +91 prefix
  // Remove leading 0 or +91 if present, then add 91
  const cleanPhone = phone.replace(/^(\+91|91|0)/, "");
  const waUrl = `https://wa.me/91${cleanPhone}?text=${encodeURIComponent(message)}`;

  window.open(waUrl, "_blank");
}

/* =========================
FETCH QUEUE
========================= */

async function fetchQueue(){

  if(isFetching) return;
  if(activeInputPhone) return;

  isFetching = true;

  try{

    const shopId = "<%= shop.shopId %>";

    const res = await fetch(`${BASE_URL}/api/queue/${shopId}`, {
      headers: {
        "Authorization": `Bearer ${token}`
      }
    });

    if(res.status === 401){
      localStorage.clear();
      window.location.href = "/";
      return;
    }

    if(!res.ok){
      throw new Error("Failed");
    }

    const data = await res.json();

    const table = document.getElementById("queueTable");
    const waiting = document.getElementById("waitingCount");

    if(!data.length){
      table.innerHTML = `
      <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Visits</th>
        <th>Total Spent</th>
        <th>Points</th>
        <th>Action</th>
      </tr>
      <tr>
        <td colspan="6" class="empty">No customers in queue</td>
      </tr>`;
      waiting.innerText = 0;
      return;
    }

    waiting.innerText = data.length;

    let rows = "";

    data.forEach(customer => {

      const savedValue = inputCache[customer.phone] || "";

      rows += `
      <tr>
        <td>${safe(customer.name)}</td>
        <td>${customer.phone}</td>
        <td>${customer.visits}</td>
        <td>₹${customer.totalSpent}</td>
        <td>${customer.points}</td>
        <td>
          <input
            type="number"
            id="amount-${customer.phone}"
            placeholder="Amount"
            value="${savedValue}"
            onfocus="activeInputPhone='${customer.phone}'"
            onblur="activeInputPhone=null"
            oninput="inputCache['${customer.phone}']=this.value"
          >
          <button onclick="givePoints('${customer.phone}', '${customer.queueId}', '${safe(customer.name)}', this)">
            Give
          </button>
          <div id="msg-${customer.phone}"></div>
        </td>
      </tr>`;
    });

    table.innerHTML = `
    <tr>
      <th>Name</th>
      <th>Phone</th>
      <th>Visits</th>
      <th>Total Spent</th>
      <th>Points</th>
      <th>Action</th>
    </tr>
    ${rows}`;

  }catch(err){
    console.log(err);
  }finally{
    isFetching = false;
  }
}

/* =========================
ADD POINTS + WHATSAPP
========================= */

async function givePoints(phone, queueId, customerName, btn){

  if(btn.disabled) return;

  const amountInput = document.getElementById(`amount-${phone}`);
  const amount = amountInput.value;
  const msg = document.getElementById(`msg-${phone}`);

  if(!amount || amount <= 0){
    msg.innerHTML="<span class='error'>Enter amount</span>";
    return;
  }

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{

    const res = await fetch(`${BASE_URL}/api/transactions`,{
      method:"POST",
      headers:{
        "Content-Type":"application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ phone, shopId, billAmount: amount, queueId })
    });

    const data = await res.json();

    if(res.ok){

      // ✅ Show success + WhatsApp button
      msg.innerHTML = `
        <span class="success">+${data.pointsEarned} pts ✓</span>
        <button
          class="wa-btn"
          onclick="sendWhatsApp('${phone}', '${customerName}', ${data.pointsEarned}, ${data.totalPoints})">
          📲 WhatsApp
        </button>`;

      // ✅ Clear input cache
      delete inputCache[phone];
      amountInput.value = "";

      setTimeout(fetchQueue, 1000);

    } else {
      msg.innerHTML=`<span class='error'>${data.message || "Error"}</span>`;
    }

  }catch{
    msg.innerHTML="<span class='error'>Error</span>";
  }

  btn.disabled = false;
  btn.innerText = "Give";
}

/* =========================
AUTO REFRESH
========================= */

fetchQueue();

setInterval(()=>{
  if(!document.hidden && !activeInputPhone){
    fetchQueue();
  }
},3000);

/* =========================
PWA INSTALL
========================= */

let deferredPrompt;

window.addEventListener("beforeinstallprompt",(e)=>{
  e.preventDefault();
  deferredPrompt = e;

  const btn = document.getElementById("installBtn");
  btn.style.display="inline-block";

  btn.onclick = async ()=>{
    deferredPrompt.prompt();
    const choice = await deferredPrompt.userChoice;
    if(choice.outcome==="accepted"){
      btn.style.display="none";
    }
  };
});

/* =========================
SERVICE WORKER
========================= */

if("serviceWorker" in navigator){
  navigator.serviceWorker.register("/sw.js");
}

</script>

</body>
</html>
