<!DOCTYPE html>
<html>
<head>

<title>Keepl Dashboard</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#FF6B00">

<link rel="stylesheet" href="/keepl.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

<style>
body {
  font-family: Arial, sans-serif;
  background: var(--k-bg);
  margin: 0;
  padding: 0;
}

.k-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px 20px 40px;
}

/* ── Overrides for table inside k-card ── */
table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px 14px;
  border-bottom: 0.5px solid var(--k-border);
  text-align: left;
  font-size: 14px;
}

th {
  background: var(--k-bg);
  color: var(--k-ink-secondary);
  font-weight: 500;
  font-size: 13px;
}

td {
  color: var(--k-ink);
}

input[type="number"] {
  padding: 8px 12px;
  border-radius: var(--k-r-sm);
  border: 1.5px solid var(--k-border);
  width: 110px;
  font-size: 14px;
  font-family: inherit;
  color: var(--k-ink);
  outline: none;
  transition: border-color 0.15s;
}

input[type="number"]:focus {
  border-color: var(--k-saffron);
  box-shadow: 0 0 0 3px rgba(255,107,0,0.10);
}

.success {
  color: var(--k-teal);
  font-size: 13px;
  font-weight: 500;
  margin-top: 4px;
}

.error {
  color: var(--k-danger);
  font-size: 13px;
  margin-top: 4px;
}

/* ── Settings row ── */
.settings-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.settings-row label {
  font-size: 14px;
  color: var(--k-ink-secondary);
  white-space: nowrap;
}

.settings-row input[type="number"] {
  width: 90px;
}

.settings-hint {
  font-size: 12px;
  color: var(--k-ink-tertiary);
  margin-top: 8px;
}

/* ── QR section ── */
.qrSection {
  text-align: center;
}

.qrSection img {
  border-radius: var(--k-r-md);
  padding: 12px;
  background: white;
  box-shadow: 0 4px 16px rgba(26,26,46,0.08);
  border: 0.5px solid var(--k-border);
}

/* ── Empty queue ── */
.empty {
  text-align: center;
  padding: 28px;
  color: var(--k-ink-tertiary);
  font-size: 14px;
}

/* ── Install button ── */
#installBtn {
  display: none;
}

@media (max-width: 600px) {
  /* Nav */
  #navLinks { display: none !important; }
  .k-nav { padding: 0 12px; height: 52px; }
  .k-nav-actions { gap: 6px; }
  .k-btn-sm { padding: 6px 10px; font-size: 12px; }

  /* Page */
  body { padding: 0; }
  .k-page { padding: 12px 12px 40px; }

  /* Stat cards */
  .k-stat-grid { grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
  .k-stat-num { font-size: 26px; }

  /* Cards */
  .k-card { padding: 16px 12px; margin-bottom: 14px; }

  /* Search */
  #customerSearchInput { font-size: 16px; }

  /* Queue table — stack on mobile */
  table { display: block; }
  thead { display: none; }
  tbody { display: block; }
  tr {
    display: flex;
    flex-direction: column;
    background: var(--k-surface);
    border: 0.5px solid var(--k-border);
    border-radius: var(--k-r-md);
    padding: 12px;
    margin-bottom: 10px;
    gap: 8px;
  }
  td {
    display: flex;
    align-items: center;
    padding: 0;
    border: none;
    font-size: 13px;
  }

  /* Bill input full width on mobile */
  input[type="number"] { width: 100%; font-size: 16px; }

  /* Give and Redeem buttons full width */
  .k-queue-actions { width: 100%; }
  .k-queue-actions .k-btn { flex: 1; justify-content: center; }

  /* Settings */
  .settings-row { flex-direction: column; align-items: flex-start; }
  .settings-row input[type="number"] { width: 100%; }
}
</style>

</head>

<body>

<!-- Toast container — expiry alerts appear here -->
<div id="toastContainer"></div>

<!-- ── Navigation ── -->
<nav class="k-nav">
  <div class="k-nav-logo">
    <div class="k-nav-logo-icon"><i class="ti ti-bolt"></i></div>
    <div class="k-nav-logo-text">keep<span>l</span></div>
  </div>

  <div class="k-nav-links" style="display:flex;gap:20px;align-items:center;" id="navLinks">
    <a href="/customers/<%= shop.shopId %>" style="font-size:13px;color:var(--k-ink-tertiary);text-decoration:none;display:flex;align-items:center;gap:5px;"><i class="ti ti-users"></i> Customers</a>
    <a href="/analytics/<%= shop.shopId %>" style="font-size:13px;color:var(--k-ink-tertiary);text-decoration:none;display:flex;align-items:center;gap:5px;"><i class="ti ti-chart-bar"></i> Analytics</a>
  </div>
  <div class="k-nav-actions">
    <button id="installBtn" class="k-btn k-btn-teal k-btn-sm">
      <i class="ti ti-download"></i> Install App
    </button>

    <a href="/poster/<%= shop.shopId %>">
      <button class="k-btn k-btn-ghost k-btn-sm">
        <i class="ti ti-qrcode"></i> QR Poster
      </button>
    </a>

    <button class="k-btn k-btn-danger k-btn-sm" onclick="logout()">
      <i class="ti ti-logout"></i> Logout
    </button>
  </div>
</nav>

<!-- ── Page content ── -->
<div class="k-page">

  <!-- Shop name heading -->
  <div style="margin-bottom:24px;">
    <h2 style="font-size:22px;font-weight:500;color:var(--k-ink);margin:0 0 4px;">
      <%= shop.name %>
    </h2>
    <p style="font-size:14px;color:var(--k-ink-tertiary);margin:0;">
      Welcome back — here's your dashboard
    </p>
  </div>

  <!-- ── Stat cards ── -->
  <div class="k-stat-grid">
    <div class="k-stat-card k-stat-saffron">
      <i class="ti ti-users k-stat-icon"></i>
      <div class="k-stat-label">Customers Today</div>
      <div class="k-stat-num" id="customersToday"><%= customersToday %></div>
    </div>

    <div class="k-stat-card k-stat-teal">
      <i class="ti ti-bolt k-stat-icon"></i>
      <div class="k-stat-label">Points Given Today</div>
      <div class="k-stat-num" id="pointsToday"><%= pointsToday %></div>
    </div>

    <div class="k-stat-card k-stat-dark">
      <i class="ti ti-clock k-stat-icon"></i>
      <div class="k-stat-label">Total Waiting</div>
      <div class="k-stat-num" id="waitingCount"><%= customers.length %></div>
    </div>
  </div>

  <!-- ── Manual Customer Search ── -->
  <div class="k-card" style="margin-bottom:20px;">
    <div class="k-card-title">
      <i class="ti ti-search" style="color:var(--k-saffron);"></i>
      Give Points Without Scan
    </div>
    <p style="font-size:13px;color:var(--k-ink-tertiary);margin-bottom:14px;">
      Search a regular customer by phone or name and give points directly.
    </p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <input
        type="text"
        id="customerSearchInput"
        placeholder="Phone number or name..."
        class="k-input"
        style="flex:1;min-width:200px;"
        oninput="searchCustomer(this.value)"
      />
    </div>
    <div id="customerSearchResult" style="margin-top:12px;"></div>
  </div>

    <!-- ── Queue card ── -->
  <div class="k-card">
    <div class="k-card-title">
      <i class="ti ti-list-check" style="color:var(--k-saffron);"></i>
      Customers Waiting
    </div>
    <table id="queueTable"></table>
  </div>

  <!-- ── QR Code ── -->
  <div class="k-card qrSection">
    <div class="k-card-title" style="justify-content:center;">
      <i class="ti ti-qrcode" style="color:var(--k-saffron);"></i>
      Your Shop QR
    </div>

    <img id="shopQRImg" src="" width="200" style="display:none;">
    <p id="qrMissing" style="color:var(--k-danger);font-size:14px;display:none;">QR not generated. Please logout and login again.</p>

    <p style="margin-top:12px;font-size:14px;color:var(--k-ink-tertiary);">
      Customers scan this QR to earn rewards
    </p>
  </div>

  <!-- ── Reward Settings ── -->
  <div class="k-card">
    <!-- Collapsed summary row -->
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:10px;">
        <i class="ti ti-settings" style="color:var(--k-saffron);font-size:18px;"></i>
        <div>
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Reward Settings</div>
          <div style="font-size:13px;color:var(--k-ink-tertiary);">
            Customers need <strong id="thresholdDisplay"><%= shop.rewardThreshold || 100 %></strong> points for a free reward
          </div>
        </div>
      </div>
      <button class="k-btn k-btn-ghost k-btn-sm" onclick="toggleRewardSettings()">
        <i class="ti ti-edit"></i> Edit
      </button>
    </div>

    <!-- Expanded settings — hidden by default -->
    <div id="rewardSettingsExpanded" style="display:none;margin-top:16px;padding-top:16px;border-top:0.5px solid var(--k-border);">
      <p style="font-size:14px;color:var(--k-ink-secondary);margin-bottom:12px;">
        Set how many points a customer needs to earn a free reward.
      </p>

      <div class="settings-row">
        <label for="thresholdInput">Points needed for reward:</label>
        <input
          type="number"
          id="thresholdInput"
          min="10"
          step="10"
          value="<%= shop.rewardThreshold || 100 %>"
        />
        <button class="k-btn k-btn-primary k-btn-sm" onclick="saveRewardThreshold()">
          <i class="ti ti-device-floppy"></i> Save
        </button>
      </div>

      <p class="settings-hint">
        Minimum 10 points. Customers see this on their scan page.
      </p>
      <div id="thresholdMsg" style="margin-top:8px;"></div>
    </div>
  </div>

</div><!-- end k-page -->

<script>

/* =========================
   SESSION CHECK
========================= */
const BASE_URL = "https://keepl.onrender.com";
const token = localStorage.getItem("token");
const shopIdLocal = localStorage.getItem("shopId");
const SHOP_NAME = "<%= shop.name %>";

if(!token || !shopIdLocal){
  window.location.href="/";
}

/* =========================
   STATE
========================= */

let isFetching = false;
let activeInputPhone = null;
let inputCache = {};

// Dismissed search results
const dismissedPhones = new Set();

// Expiry tracking
let previousQueuePhones = new Set();
let lastQueueNames = {};
const recentlyProcessed = new Set();

/* =========================
   LOGOUT
========================= */

function logout(){
  if(confirm("Logout?")){
    localStorage.clear();
    window.location.href="/";
  }
}

/* =========================
   SAFE TEXT
========================= */

function safe(text){
  return String(text)
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}

/* =========================
   TOAST — expiry alert
========================= */

function showToast(message){
  const container = document.getElementById("toastContainer");
  const toast = document.createElement("div");
  toast.className = "toast";
  toast.innerText = message;
  container.appendChild(toast);

  setTimeout(()=> toast.classList.add("fadeout"), 4800);
  setTimeout(()=> toast.remove(), 5200);
}

/* =========================
   WHATSAPP — points earned
========================= */

function sendWhatsApp(phone, customerName, pointsEarned, totalPoints, amountSpent){

  const cleanPhone = String(phone).replace(/\D/g,"").replace(/^(91|0)/,"");

  const message =
    `Hi ${customerName}! 🎉\n\n` +
    `Thank you for visiting *${SHOP_NAME}*.\n\n` +
    `🧾 Amount Spent: ₹${amountSpent}\n` +
    `⭐ Points Earned: *${pointsEarned} pts*\n` +
    `🏆 Total Points: *${totalPoints} pts*\n\n` +
    `${totalPoints >= 100 ? "🎉 Congratulations! You have collected *" + totalPoints + " points*! You can now redeem your points for a free reward! Tell the shopkeeper 🎁" : "🎁 Collect *100 points* to redeem a free reward!"}\n\n` +
    `See you again soon 😊\n` +
    `– ${SHOP_NAME} via Keepl`;

  const waUrl = `https://wa.me/91${cleanPhone}?text=${encodeURIComponent(message)}`;
  const waWindow = window.open(waUrl, "_blank");

  // ✅ Fallback — if WhatsApp didn't open, show message to copy
  setTimeout(() => {
    if(!waWindow || waWindow.closed || typeof waWindow.closed === "undefined"){
      showWaFallback(phone, message);
    }
  }, 2000);
}

function showWaFallback(phone, message){
  const existing = document.getElementById("wa-fallback-modal");
  if(existing) existing.remove();

  const modal = document.createElement("div");
  modal.id = "wa-fallback-modal";
  modal.style.cssText = `
    position:fixed;top:0;left:0;right:0;bottom:0;
    background:rgba(26,26,46,0.6);z-index:9999;
    display:flex;align-items:center;justify-content:center;padding:20px;
  `;

  modal.innerHTML = \`
    <div style="background:#fff;border-radius:20px;padding:28px;max-width:420px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <div style="width:36px;height:36px;background:#E8FFF3;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">📲</div>
        <div>
          <div style="font-size:15px;font-weight:500;color:var(--k-ink);">WhatsApp didn't open</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">Copy and send this message manually</div>
        </div>
        <button onclick="document.getElementById('wa-fallback-modal').remove()" style="margin-left:auto;background:none;border:none;font-size:20px;cursor:pointer;color:var(--k-ink-tertiary);width:auto;padding:4px;">✕</button>
      </div>
      <div style="background:var(--k-bg);border:0.5px solid var(--k-border);border-radius:12px;padding:14px;font-size:13px;color:var(--k-ink-secondary);line-height:1.7;white-space:pre-wrap;max-height:200px;overflow-y:auto;">\${message}</div>
      <div style="display:flex;gap:10px;margin-top:16px;">
        <button
          onclick="navigator.clipboard.writeText(\\`\${message.replace(/\`/g, '')}\\`).then(()=>{ this.innerText='Copied!'; setTimeout(()=>{ this.innerHTML='<i class=\'ti ti-copy\'></i> Copy message'; },2000); })"
          style="flex:1;background:var(--k-saffron);color:#fff;border:none;padding:11px;border-radius:12px;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
          <i class="ti ti-copy"></i> Copy message
        </button>
        <a href="https://wa.me/91\${phone}" target="_blank"
          style="flex:1;background:#E8FFF3;color:#065F46;border:none;padding:11px;border-radius:12px;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;">
          📲 Try WhatsApp
        </a>
      </div>
    </div>
  \`;

  modal.addEventListener("click", (e) => {
    if(e.target === modal) modal.remove();
  });

  document.body.appendChild(modal);
}

/* =========================
   WHATSAPP — redeem
========================= */

function sendWhatsAppRedeem(phone, customerName, pointsRedeemed, remainingPoints){
  const cleanPhone = String(phone).replace(/\D/g, "").replace(/^(91|0)/, "");

  const message =
    `Hi ${customerName}! 🎁\n\n` +
    `Your reward has been redeemed at *${SHOP_NAME}*.\n\n` +
    `✅ Points Redeemed: *${pointsRedeemed} pts*\n` +
    `🏆 Remaining Points: *${remainingPoints} pts*\n\n` +
    `Keep visiting to earn more rewards!\n` +
    `– ${SHOP_NAME} via Keepl`;

  const waUrl = `https://wa.me/91${cleanPhone}?text=${encodeURIComponent(message)}`;
  window.open(waUrl, "_blank");
}

/* =========================
   SAVE REWARD THRESHOLD
========================= */

async function saveRewardThreshold(){
  const input = document.getElementById("thresholdInput");
  const msg = document.getElementById("thresholdMsg");
  const value = parseInt(input.value);

  msg.innerHTML = "";

  if(!value || value < 10){
    msg.innerHTML = "<span class='error'>Please enter at least 10 points</span>";
    return;
  }

  try{
    const shopId = "<%= shop.shopId %>";

    const res = await fetch(`${BASE_URL}/api/shops/${shopId}/reward-threshold`, {
      method: "PATCH",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ rewardThreshold: value })
    });

    const data = await res.json();

    if(res.ok){
      msg.innerHTML = `<span class="success">✓ Saved!</span>`;
      document.getElementById('thresholdDisplay').innerText = data.rewardThreshold;
      setTimeout(() => { document.getElementById('rewardSettingsExpanded').style.display = 'none'; }, 1000);
    } else {
      msg.innerHTML = `<span class="error">${data.message || "Failed to save"}</span>`;
    }

  }catch(err){
    console.error("Save threshold error:", err);
    msg.innerHTML = "<span class='error'>Server error. Try again.</span>";
  }
}

/* =========================
   TOGGLE REWARD SETTINGS
========================= */

function toggleRewardSettings(){
  const expanded = document.getElementById("rewardSettingsExpanded");
  const isHidden = expanded.style.display === "none";
  expanded.style.display = isHidden ? "block" : "none";
}


/* =========================
   FETCH QUEUE
========================= */

async function fetchQueue(){

  if(isFetching) return;
  if(activeInputPhone) return;

  isFetching = true;

  try{

    const shopId = "<%= shop.shopId %>";

    const res = await fetch(`${BASE_URL}/api/queue/${shopId}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if(res.status === 401){
      localStorage.clear();
      window.location.href = "/";
      return;
    }

    if(!res.ok) throw new Error("Failed");

    const data = await res.json();

    /* ── Expiry detection ── */
    const currentPhones = new Set(data.map(c => c.phone));

    previousQueuePhones.forEach(phone => {
      if(!currentPhones.has(phone) && !recentlyProcessed.has(phone)){
        const name = lastQueueNames[phone] || phone;
        showToast(`⏰ ${name} left the queue (session expired)`);
      }
    });

    recentlyProcessed.forEach(phone => {
      if(!currentPhones.has(phone)) recentlyProcessed.delete(phone);
    });

    previousQueuePhones = currentPhones;
    data.forEach(c => { lastQueueNames[c.phone] = c.name; });
    /* ── End expiry detection ── */

    const table = document.getElementById("queueTable");
    const waiting = document.getElementById("waitingCount");

    if(!data.length){
      table.innerHTML = `
        <tr>
          <th>Name</th><th>Phone</th><th>Visits</th>
          <th>Total Spent</th><th>Points</th><th>Action</th><th>Redeem</th>
        </tr>
        <tr><td colspan="7" class="empty">No customers in queue</td></tr>`;
      waiting.innerText = 0;
      return;
    }

    waiting.innerText = data.length;

    let rows = "";

    data.forEach(customer => {

      const savedValue = inputCache[customer.phone] || "";
      const initials = customer.name
        ? customer.name.split(" ").map(w=>w[0]).join("").toUpperCase().slice(0,2)
        : "?";
      const avatarColor = customer.points >= 100
        ? "background:var(--k-teal-lt);color:var(--k-teal-dk);"
        : "background:var(--k-saffron-lt);color:var(--k-saffron-dk);";

      rows += `
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:10px;">
            <div style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;flex-shrink:0;${avatarColor}">
              ${initials}
            </div>
            <div>
              <div style="font-weight:500;color:var(--k-ink);">${safe(customer.name)}</div>
              <div style="font-size:12px;color:var(--k-ink-tertiary);">${customer.visits} visit${customer.visits !== 1 ? 's' : ''}</div>
            </div>
          </div>
        </td>
        <td style="color:var(--k-ink-secondary);">${customer.phone}</td>
        <td style="color:var(--k-ink-secondary);">₹${customer.totalSpent}</td>
        <td>
          <span style="font-size:18px;font-weight:500;color:${customer.points >= 100 ? 'var(--k-teal)' : 'var(--k-saffron)'};">
            ${customer.points}
          </span>
          <span style="font-size:12px;color:var(--k-ink-tertiary);"> pts at your shop</span>
        </td>
        <td>
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <input
              type="number"
              id="amount-${customer.phone}"
              placeholder="₹ amount"
              value="${savedValue}"
              min="1"
              onfocus="activeInputPhone='${customer.phone}'"
              onblur="setTimeout(()=>{ activeInputPhone=null; }, 300)"
              oninput="inputCache['${customer.phone}']=this.value"
            >
            <button
              class="k-btn k-btn-primary k-btn-sm"
              onclick="givePoints('${customer.phone}','${customer.queueId}',this.dataset.name,this)" data-name="${customer.name}">
              <i class="ti ti-bolt"></i> Give
            </button>
          </div>
          <div id="msg-${customer.phone}" style="margin-top:4px;"></div>
        </td>
        <td>
          ${customer.points >= 100
            ? `<button
                class="k-btn k-btn-teal k-btn-sm"
                onclick="redeemPoints('${customer.phone}','${customer.queueId}',this.dataset.name,${customer.points},this)" data-name="${customer.name}">
                <i class="ti ti-gift"></i> Redeem
               </button>
               <div id="redeem-msg-${customer.phone}" style="margin-top:4px;"></div>`
            : `<span style="font-size:12px;color:var(--k-ink-tertiary);">${customer.points}/100 pts</span>`
          }
        </td>
      </tr>`;
    });

    table.innerHTML = `
    <tr>
      <th>Customer</th><th>Phone</th>
      <th>Spent</th><th>Points</th><th>Give Points</th><th>Redeem</th>
    </tr>
    ${rows}`;

  }catch(err){
    console.log("Queue fetch error:", err);
  }finally{
    isFetching = false;
  }
}

/* =========================
   LIVE STATS REFRESH
========================= */

async function fetchLiveStats(){
  try{
    const shopId = "<%= shop.shopId %>";
    const res = await fetch(`${BASE_URL}/dashboard/stats/${shopId}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if(!res.ok) return;

    const data = await res.json();
    document.getElementById("customersToday").innerText = data.customersToday;
    document.getElementById("pointsToday").innerText    = data.pointsToday;

  }catch(err){
    console.log("Stats fetch error:", err);
  }
}

/* =========================
   GIVE POINTS + WHATSAPP
========================= */

async function givePoints(phone, queueId, customerName, btn){

  if(btn.disabled) return;

  const amountInput = document.getElementById(`amount-${phone}`);
  const amount = amountInput?.value;
  const snapshotAmount = amount; // snapshot immediately before any async gap
  activeInputPhone = phone;      // lock queue refresh while processing
  const msg = document.getElementById(`msg-${phone}`);

  if(!snapshotAmount || snapshotAmount <= 0){
    msg.innerHTML = "<span class='error'>Enter a valid amount</span>";
    return;
  }

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{

    const res = await fetch(`${BASE_URL}/api/transactions`,{
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({
        phone,
        shopId,
        billAmount: Number(snapshotAmount),
        queueId
      })
    });

    const data = await res.json();

    if(res.ok){

      const earned = data.pointsEarned;
      const total  = data.totalPoints;
      const spent  = snapshotAmount;

      msg.innerHTML = `
        <span class="success">+${earned} pts ✓</span>
        <button
          class="k-wa-btn"
          style="margin-left:6px;"
          onclick="sendWhatsApp('${phone}',${JSON.stringify(customerName)},${earned},${total},${spent})">
          📲 WhatsApp
        </button>`;

      sendWhatsApp(phone, customerName, earned, total, spent);

      recentlyProcessed.add(phone);

      amountInput.value = "";
      delete inputCache[phone];
      activeInputPhone = null; // release lock

      setTimeout(fetchQueue, 1000);

    }else{
      msg.innerHTML = `<span class='error'>${data.message || "Error"}</span>`;
    }

  }catch(err){
    console.error("Give points error:", err);
    msg.innerHTML = "<span class='error'>Server error</span>";
    activeInputPhone = null; // release lock on error
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="ti ti-bolt"></i> Give';
}

/* =========================
   REDEEM POINTS + WHATSAPP
========================= */

async function redeemPoints(phone, queueId, customerName, currentPoints, btn){

  if(btn.disabled) return;

  const confirmed = confirm(
    `Redeem 100 points for ${customerName}?\nThey have ${currentPoints} pts. Remaining after: ${currentPoints - 100} pts.`
  );
  if(!confirmed) return;

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";
  const msg = document.getElementById(`redeem-msg-${phone}`);

  try{

    const res = await fetch(`${BASE_URL}/api/redeem`,{
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({ phone, shopId, points: 100, queueId })
    });

    const data = await res.json();

    if(res.ok){
      msg.innerHTML = `<span class="success">Redeemed ✓</span>
        <button class="k-wa-btn" style="margin-left:6px;"
          onclick="sendWhatsAppRedeem('${phone}',${JSON.stringify(customerName)},100,${data.remainingPoints})">
          📲 WhatsApp
        </button>`;

      sendWhatsAppRedeem(phone, customerName, 100, data.remainingPoints);

      recentlyProcessed.add(phone);

      setTimeout(fetchQueue, 1000);

    }else{
      msg.innerHTML = `<span class="error">${data.message || "Error"}</span>`;
      btn.disabled = false;
      btn.innerHTML = '<i class="ti ti-gift"></i> Redeem';
    }

  }catch(err){
    console.error("Redeem error:", err);
    msg.innerHTML = "<span class='error'>Server error</span>";
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-gift"></i> Redeem';
  }
}

/* =========================
   AUTO REFRESH
========================= */

fetchQueue();
fetchLiveStats();
loadQR();

function loadQR(){
  const qr = localStorage.getItem('qrCode');
  const img = document.getElementById('shopQRImg');
  const missing = document.getElementById('qrMissing');
  if(qr && img){
    img.src = qr;
    img.style.display = 'block';
  } else if(missing){
    missing.style.display = 'block';
  }
}

/* =========================
   MANUAL CUSTOMER SEARCH
========================= */

async function searchCustomer(query){
  const resultDiv = document.getElementById("customerSearchResult");

  if(!query || query.length < 3){
    resultDiv.innerHTML = "";
    return;
  }

  try{
    const shopId = "<%= shop.shopId %>";
    const res = await fetch(`${BASE_URL}/api/customers/shop/${shopId}`, {
      headers: { "Authorization": `Bearer ${token}` }
    });

    if(!res.ok) return;

    const customers = await res.json();

    const q = query.toLowerCase();
    const matched = customers.filter(c =>
      !dismissedPhones.has(c.phone) &&
      ((c.name || "").toLowerCase().includes(q) ||
      (c.phone || "").includes(q))
    ).slice(0, 5);

    if(!matched.length){
      resultDiv.innerHTML = `<p style="font-size:13px;color:var(--k-ink-tertiary);margin-top:8px;">No customers found</p>`;
      return;
    }

    resultDiv.innerHTML = matched.map(c => {
      const initials = c.name ? c.name.split(" ").map(w=>w[0]).join("").toUpperCase().slice(0,2) : "?";
      return `
      <div id="search-row-${c.phone}" style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:0.5px solid var(--k-border);">
        <div style="width:40px;height:40px;border-radius:10px;background:var(--k-saffron-lt);color:var(--k-saffron-dk);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;flex-shrink:0;">
          ${initials}
        </div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">${safe(c.name)}</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">${c.phone} · ${c.points} pts at your shop</div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <input
            type="number"
            id="search-amount-${c.phone}"
            placeholder="₹ amount"
            min="1"
            style="width:100px;padding:7px 10px;border:1.5px solid var(--k-border);border-radius:var(--k-r-sm);font-size:13px;font-family:inherit;outline:none;"
            onfocus="activeInputPhone='${c.phone}'"
            onblur="setTimeout(()=>{ activeInputPhone=null; }, 300)"
          >
          <button
            class="k-btn k-btn-primary k-btn-sm"
            data-name="${c.name}"
            onclick="givePointsManual('${c.phone}', this.dataset.name, this)">
            <i class="ti ti-bolt"></i> Give
          </button>
          <button
            class="k-btn k-btn-sm"
            style="background:var(--k-bg);color:var(--k-ink-tertiary);border:0.5px solid var(--k-border);"
            onclick="dismissedPhones.add('${c.phone}'); document.getElementById('search-row-${c.phone}').remove()">
            <i class="ti ti-x"></i>
          </button>
        </div>
      </div>`;
    }).join("");

  }catch(err){
    console.error("Search error:", err);
  }
}

/* =========================
   GIVE POINTS MANUAL (no queue)
========================= */

async function givePointsManual(phone, customerName, btn){
  if(btn.disabled) return;

  const amountInput = document.getElementById(`search-amount-${phone}`);
  const snapshotAmount = amountInput?.value;
  activeInputPhone = phone;

  if(!snapshotAmount || snapshotAmount <= 0){
    alert("Enter a valid bill amount");
    activeInputPhone = null;
    return;
  }

  btn.disabled = true;
  btn.innerText = "...";

  const shopId = "<%= shop.shopId %>";

  try{
    const res = await fetch(`${BASE_URL}/api/transactions`, {
      method: "POST",
      headers:{
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`
      },
      body: JSON.stringify({
        phone,
        shopId,
        billAmount: Number(snapshotAmount)
      })
    });

    const data = await res.json();

    if(res.ok){
      const earned = data.pointsEarned;
      const total  = data.totalPoints;

      sendWhatsApp(phone, customerName, earned, total, snapshotAmount);

      amountInput.value = "";
      activeInputPhone = null;

      // Refresh search results
      const q = document.getElementById("customerSearchInput").value;
      searchCustomer(q);

      // Show success briefly
      const row = btn.closest('div[style*="border-bottom"]');
      if(row){
        const msg = document.createElement('span');
        msg.style.cssText = 'font-size:12px;color:var(--k-teal);font-weight:500;margin-left:8px;';
        msg.innerText = '+' + earned + ' pts ✓';
        btn.parentElement.appendChild(msg);
        setTimeout(() => msg.remove(), 3000);
      }

    }else{
      alert(data.message || "Failed to give points");
    }

  }catch(err){
    console.error("Manual give error:", err);
    alert("Server error");
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="ti ti-bolt"></i> Give';
  activeInputPhone = null;
}

setInterval(fetchLiveStats, 30000);

setInterval(()=>{
  if(!document.hidden && !activeInputPhone){
    fetchQueue();
  }
}, 3000);

/* =========================
   PWA INSTALL
========================= */

let deferredPrompt;

window.addEventListener("beforeinstallprompt",(e)=>{
  e.preventDefault();
  deferredPrompt = e;

  const btn = document.getElementById("installBtn");
  btn.style.display = "inline-flex";

  btn.onclick = async ()=>{
    deferredPrompt.prompt();
    const choice = await deferredPrompt.userChoice;
    if(choice.outcome === "accepted") btn.style.display = "none";
  };
});

