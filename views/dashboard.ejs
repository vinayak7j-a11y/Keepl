<!DOCTYPE html>
<html>
<head>

<title>Keepl Dashboard</title>

<meta name="viewport" content="width=device-width, initial-scale=1">

<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#FF6B00">

<link rel="stylesheet" href="/keepl.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

<style>
body {
  font-family: Arial, sans-serif;
  background: var(--k-bg);
  margin: 0;
  padding: 0;
}

.k-page {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px 20px 40px;
}

/* ── Overrides for table inside k-card ── */
table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px 14px;
  border-bottom: 0.5px solid var(--k-border);
  text-align: left;
  font-size: 14px;
}

th {
  background: var(--k-bg);
  color: var(--k-ink-secondary);
  font-weight: 500;
  font-size: 13px;
}

td {
  color: var(--k-ink);
}

input[type="number"] {
  padding: 8px 12px;
  border-radius: var(--k-r-sm);
  border: 1.5px solid var(--k-border);
  width: 110px;
  font-size: 14px;
  font-family: inherit;
  color: var(--k-ink);
  outline: none;
  transition: border-color 0.15s;
}

input[type="number"]:focus {
  border-color: var(--k-saffron);
  box-shadow: 0 0 0 3px rgba(255,107,0,0.10);
}

.success {
  color: var(--k-teal);
  font-size: 13px;
  font-weight: 500;
  margin-top: 4px;
}

.error {
  color: var(--k-danger);
  font-size: 13px;
  margin-top: 4px;
}

/* ── Settings row ── */
.settings-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.settings-row label {
  font-size: 14px;
  color: var(--k-ink-secondary);
  white-space: nowrap;
}

.settings-row input[type="number"] {
  width: 90px;
}

.settings-hint {
  font-size: 12px;
  color: var(--k-ink-tertiary);
  margin-top: 8px;
}

/* ── QR section ── */
.qrSection {
  text-align: center;
}

.qrSection img {
  border-radius: var(--k-r-md);
  padding: 12px;
  background: white;
  box-shadow: 0 4px 16px rgba(26,26,46,0.08);
  border: 0.5px solid var(--k-border);
}

/* ── Empty queue ── */
.empty {
  text-align: center;
  padding: 28px;
  color: var(--k-ink-tertiary);
  font-size: 14px;
}


/* ── Support card ── */
.support-item {
  border-radius: var(--k-r-sm);
  border: 0.5px solid var(--k-border);
  overflow: hidden;
  cursor: pointer;
}

.support-q {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  font-size: 13px;
  font-weight: 500;
  color: var(--k-ink);
  background: var(--k-bg);
}

.support-icon {
  font-size: 14px;
  color: var(--k-saffron);
  flex-shrink: 0;
  transition: transform 0.2s;
}

.support-a {
  display: none;
  padding: 10px 14px;
  font-size: 13px;
  color: var(--k-ink-secondary);
  line-height: 1.6;
  background: var(--k-surface);
  border-top: 0.5px solid var(--k-border);
}

.support-item.open .support-a { display: block; }
.support-item.open .support-icon { transform: rotate(45deg); }

/* ── Install button ── */
#installBtn {
  display: none;
}

@media (max-width: 600px) {
  /* Nav */
  #navLinks { display: none !important; }
  .k-nav { padding: 0 12px; height: 52px; }
  .k-nav-actions { gap: 6px; }
  .k-btn-sm { padding: 6px 10px; font-size: 12px; }

  /* Page */
  body { padding: 0; }
  .k-page { padding: 12px 12px 40px; }

  /* Stat cards */
  .k-stat-grid { grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
  .k-stat-num { font-size: 26px; }

  /* Cards */
  .k-card { padding: 16px 12px; margin-bottom: 14px; }

  /* Search */
  #customerSearchInput { font-size: 16px; }

  /* Queue table — stack on mobile */
  table { display: block; }
  thead { display: none; }
  tbody { display: block; }
  tr {
    display: flex;
    flex-direction: column;
    background: var(--k-surface);
    border: 0.5px solid var(--k-border);
    border-radius: var(--k-r-md);
    padding: 12px;
    margin-bottom: 10px;
    gap: 8px;
  }
  td {
    display: flex;
    align-items: center;
    padding: 0;
    border: none;
    font-size: 13px;
  }

  /* Bill input full width on mobile */
  input[type="number"] { width: 100%; font-size: 16px; }

  /* Give and Redeem buttons full width */
  .k-queue-actions { width: 100%; }
  .k-queue-actions .k-btn { flex: 1; justify-content: center; }

  /* Settings */
  .settings-row { flex-direction: column; align-items: flex-start; }
  .settings-row input[type="number"] { width: 100%; }
}
</style>

</head>

<body>

<!-- Toast container — expiry alerts appear here -->
<div id="toastContainer"></div>

<!-- ── Navigation ── -->
<nav class="k-nav">
  <div class="k-nav-logo">
    <div class="k-nav-logo-icon"><i class="ti ti-bolt"></i></div>
    <div class="k-nav-logo-text">keep<span>l</span></div>
  </div>

  <div class="k-nav-links" style="display:flex;gap:20px;align-items:center;" id="navLinks">
    <a href="/customers/<%= shop.shopId %>" style="font-size:13px;color:var(--k-ink-tertiary);text-decoration:none;display:flex;align-items:center;gap:5px;"><i class="ti ti-users"></i> Customers</a>
    <a href="/analytics/<%= shop.shopId %>" style="font-size:13px;color:var(--k-ink-tertiary);text-decoration:none;display:flex;align-items:center;gap:5px;"><i class="ti ti-chart-bar"></i> Analytics</a>
  </div>
  <div class="k-nav-actions">
    <button id="installBtn" class="k-btn k-btn-teal k-btn-sm">
      <i class="ti ti-download"></i> Install App
    </button>
    
    <button
  class="k-btn k-btn-ghost k-btn-sm"
  onclick="openQRModal()"
>
  <i class="ti ti-qrcode"></i> QR Code
</button>

<a href="/poster/<%= shop.shopId %>">
  <button class="k-btn k-btn-ghost k-btn-sm">
    <i class="ti ti-printer"></i> QR Poster
  </button>
</a>
    

    <button class="k-btn k-btn-danger k-btn-sm" onclick="logout()">
      <i class="ti ti-logout"></i> Logout
    </button>
  </div>
</nav>

<!-- ── Page content ── -->
<div class="k-page">

<% if (trialDaysLeft !== null && trialDaysLeft <= 7) { %>
<%
  var isTrialExpired = trialDaysLeft <= 0;
  var bannerBg = isTrialExpired ? '#FCEBEB' : '#FEF3E2';
  var bannerBorder = isTrialExpired ? '#F09595' : '#F5C07A';
  var headingColor = isTrialExpired ? '#791F1F' : '#7A3F00';
  var subtextColor = isTrialExpired ? '#A03030' : '#9A5000';
  var bannerIcon = isTrialExpired ? '🔒' : '⏳';
  var bannerTitle = isTrialExpired ? 'Your free trial has ended' : (trialDaysLeft + ' day' + (trialDaysLeft === 1 ? '' : 's') + ' left in your free trial');
  var bannerText = isTrialExpired ? 'Contact us on WhatsApp to continue using Keepl.' : 'Enjoying Keepl? Contact us to continue after your trial.';
%>
<div style="background:<%- bannerBg %>;border:0.5px solid <%- bannerBorder %>;border-radius:var(--k-r-md);padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:12px;">
  <span style="font-size:20px;"><%- bannerIcon %></span>
  <div>
    <div style="font-size:14px;font-weight:500;color:<%- headingColor %>;"><%- bannerTitle %></div>
    <div style="font-size:13px;color:<%- subtextColor %>;margin-top:2px;">
      <%- bannerText %>
      <a href="https://wa.me/919285273124" target="_blank" style="color:var(--k-saffron);font-weight:500;text-decoration:none;">WhatsApp us →</a>
    </div>
  </div>
</div>
<% } %>

<!-- Shop name heading -->
<div style="margin-bottom:24px;">
  <h2 style="font-size:22px;font-weight:500;color:var(--k-ink);margin:0 0 4px;">
    <%= shop.name %>
  </h2>
  <p style="font-size:14px;color:var(--k-ink-tertiary);margin:0;">
    Welcome back — here's your dashboard
  </p>
</div>

<!-- ── Onboarding Checklist ── -->
<div id="onboardingChecklist" style="display:none;margin-bottom:24px;">
  <div class="k-card" style="border-left:3px solid var(--k-saffron);padding:18px 20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <i class="ti ti-rocket" style="color:var(--k-saffron);font-size:18px;"></i>
        <span style="font-size:15px;font-weight:500;color:var(--k-ink);">Get started with Keepl</span>
      </div>
      <button onclick="dismissChecklist()" style="background:none;border:none;cursor:pointer;color:var(--k-ink-tertiary);font-size:18px;padding:0;line-height:1;">✕</button>
    </div>

    <div style="display:flex;flex-direction:column;gap:10px;" id="checklistSteps">

      <!-- Step 1 -->
      <div id="step1" style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--k-r-md);background:var(--k-bg);border:0.5px solid var(--k-border);">
        <div id="step1-icon" style="width:28px;height:28px;border-radius:50%;border:2px solid var(--k-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--k-ink-tertiary);">1</div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Print your QR poster</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">Stick it at your counter so customers can scan</div>
        </div>
        <a href="/poster/<%= shop.shopId %>">
          <button class="k-btn k-btn-ghost k-btn-sm"><i class="ti ti-qrcode"></i> Open Poster</button>
        </a>
      </div>

      <!-- Step 2 -->
      <div id="step2" style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--k-r-md);background:var(--k-bg);border:0.5px solid var(--k-border);">
        <div id="step2-icon" style="width:28px;height:28px;border-radius:50%;border:2px solid var(--k-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--k-ink-tertiary);">2</div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Get your first customer to scan</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">They scan the QR, fill their name and phone</div>
        </div>
      </div>

      <!-- Step 3 -->
      <div id="step3" style="display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:var(--k-r-md);background:var(--k-bg);border:0.5px solid var(--k-border);">
        <div id="step3-icon" style="width:28px;height:28px;border-radius:50%;border:2px solid var(--k-border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;color:var(--k-ink-tertiary);">3</div>
        <div style="flex:1;">
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Give your first points</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">Enter their bill amount and hit Give</div>
        </div>
      </div>

    </div>
  </div>
</div>

  <!-- ── Stat cards ── -->
  <div class="k-stat-grid">
    <div class="k-stat-card k-stat-saffron">
      <i class="ti ti-users k-stat-icon"></i>
      <div class="k-stat-label">Customers Today</div>
      <div class="k-stat-num" id="customersToday"><%= customersToday %></div>
    </div>

    <div class="k-stat-card k-stat-teal">
      <i class="ti ti-bolt k-stat-icon"></i>
      <div class="k-stat-label">Points Given Today</div>
      <div class="k-stat-num" id="pointsToday"><%= pointsToday %></div>
    </div>

    <div class="k-stat-card k-stat-dark">
      <i class="ti ti-clock k-stat-icon"></i>
      <div class="k-stat-label">Total Waiting</div>
      <div class="k-stat-num" id="waitingCount"><%= customers.length %></div>
    </div>
  </div>

  <!-- ── Manual Customer Search ── -->
  <div class="k-card" style="margin-bottom:20px;">
    <div class="k-card-title">
      <i class="ti ti-search" style="color:var(--k-saffron);"></i>
      Give Points Without Scan
    </div>
    <p style="font-size:13px;color:var(--k-ink-tertiary);margin-bottom:14px;">
      Search a regular customer by phone or name and give points directly.
    </p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <input
        type="text"
        id="customerSearchInput"
        placeholder="Phone number or name..."
        class="k-input"
        style="flex:1;min-width:200px;"
        oninput="searchCustomer(this.value)"
      />
    </div>
    <div id="customerSearchResult" style="margin-top:12px;"></div>
  </div>

  <!-- ── Queue card ── -->
  <div class="k-card">
    <div class="k-card-title">
      <i class="ti ti-list-check" style="color:var(--k-saffron);"></i>
      Customers Waiting
    </div>
    <table id="queueTable"></table>
  </div> 

  <!-- ── Reward Settings ── -->
  <div class="k-card">
    <!-- Collapsed summary row -->
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:10px;">
        <i class="ti ti-settings" style="color:var(--k-saffron);font-size:18px;"></i>
        <div>
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Reward Settings</div>
          <div style="font-size:13px;color:var(--k-ink-tertiary);">
            Customers need <strong id="thresholdDisplay"><%= shop.rewardThreshold || 100 %></strong> points for <strong id="rewardNameDisplay"><%= shop.rewardName || 'Free reward' %></strong>
          </div>
        </div>
      </div>
      <button class="k-btn k-btn-ghost k-btn-sm" onclick="toggleRewardSettings()">
        <i class="ti ti-edit"></i> Edit
      </button>
    </div>

    <!-- Expanded settings — hidden by default -->
    <div id="rewardSettingsExpanded" style="display:none;margin-top:16px;padding-top:16px;border-top:0.5px solid var(--k-border);">
      <p style="font-size:14px;color:var(--k-ink-secondary);margin-bottom:12px;">
        Set how many points a customer needs to earn a free reward.
      </p>

      <div class="settings-row">
        <label for="thresholdInput">Points needed for reward:</label>
        <input
          type="number"
          id="thresholdInput"
          min="10"
          step="10"
          value="<%= shop.rewardThreshold || 100 %>"
        />
        <button class="k-btn k-btn-primary k-btn-sm" onclick="saveRewardThreshold()">
          <i class="ti ti-device-floppy"></i> Save
        </button>
      </div>

      <p class="settings-hint">
        Minimum 10 points. Customers see this on their scan page.
      </p>
      <div id="thresholdMsg" style="margin-top:8px;"></div>

      <div style="margin-top:20px;padding-top:16px;border-top:0.5px solid var(--k-border);">
        <p style="font-size:14px;color:var(--k-ink-secondary);margin-bottom:12px;">
          What do customers get when they hit <strong><%= shop.rewardThreshold || 100 %></strong> points?
        </p>
        <div class="settings-row">
          <label for="rewardNameInput">Reward name:</label>
          <input
            type="text"
            id="rewardNameInput"
            placeholder="e.g. Free chai, ₹50 off"
            maxlength="80"
            value="<%= shop.rewardName || 'Free reward' %>"
            style="flex:1;min-width:180px;padding:8px 12px;border-radius:var(--k-r-sm);border:1.5px solid var(--k-border);font-size:14px;font-family:inherit;color:var(--k-ink);outline:none;"
            onfocus="this.style.borderColor='var(--k-saffron)'"
            onblur="this.style.borderColor='var(--k-border)'"
          />
          <button class="k-btn k-btn-primary k-btn-sm" onclick="saveRewardName()">
            <i class="ti ti-device-floppy"></i> Save
          </button>
        </div>
        <p class="settings-hint">Customers see this on their thank-you page as their reward goal.</p>
        <div id="rewardNameMsg" style="margin-top:8px;"></div>
      </div>
    </div>
  </div>


  <!-- ── Help & Support ── -->
  <div class="k-card" style="margin-top:20px;">
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:10px;">
        <i class="ti ti-headset" style="color:var(--k-saffron);font-size:18px;"></i>
        <div>
          <div style="font-size:14px;font-weight:500;color:var(--k-ink);">Help & Support</div>
          <div style="font-size:13px;color:var(--k-ink-tertiary);">Koi problem? Hum yahan hain</div>
        </div>
      </div>
      <button class="k-btn k-btn-ghost k-btn-sm" onclick="toggleSupport()">
        <i class="ti ti-chevron-down" id="supportChevron"></i> Help topics
      </button>
    </div>

    <!-- Contact buttons -->
    <div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;">
      <a href="https://wa.me/919285273124" target="_blank"
        style="display:inline-flex;align-items:center;gap:7px;padding:10px 18px;background:#25D366;color:white;border-radius:10px;text-decoration:none;font-size:13px;font-weight:500;">
        <i class="ti ti-brand-whatsapp" style="font-size:16px;"></i> WhatsApp Support
      </a>
      <a href="tel:+919285273124"
        style="display:inline-flex;align-items:center;gap:7px;padding:10px 18px;background:var(--k-bg);color:var(--k-ink);border:0.5px solid var(--k-border);border-radius:10px;text-decoration:none;font-size:13px;font-weight:500;">
        <i class="ti ti-phone" style="font-size:16px;color:var(--k-saffron);"></i> Call Us
      </a>
    </div>

    <!-- Help topics — hidden by default -->
    <div id="supportTopics" style="display:none;margin-top:16px;padding-top:16px;border-top:0.5px solid var(--k-border);">
      <div style="display:flex;flex-direction:column;gap:8px;">

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> Customer queue mein nahi dikh raha</div>
          <div class="support-a">Customer ne QR scan kiya hoga — dashboard refresh karo (3 sec mein auto update hota hai). Agar phir bhi nahi dikh raha toh "Give Points Without Scan" se phone number search karo aur directly points do.</div>
        </div>

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> WhatsApp message nahi gaya customer ko</div>
          <div class="support-a">Give dabane ke baad WhatsApp automatically open hota hai. Agar nahi hua toh "WhatsApp" button dobara dabao — ya message copy karke manually bhejo. Customer ka number sahi hai yeh check karo.</div>
        </div>

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> Galat points de diye — undo kaise karein</div>
          <div class="support-a">Give karne ke turant baad "↩ Undo" button aata hai — 5 minute ke andar use karo. 5 minute baad undo nahi hoga. Agar late ho gaye toh WhatsApp pe contact karo.</div>
        </div>

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> QR poster print karna hai</div>
          <div class="support-a">Nav mein "QR Poster" button dabao — poster open hoga. Wahan se print karo ya PDF save karo. A5 ya A4 dono pe print ho sakta hai.</div>
        </div>

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> Reward change karna hai</div>
          <div class="support-a">Neeche "Reward Settings" mein jaao — "Edit" dabao. Points threshold aur reward name dono change kar sakte ho. Save karte hi customers ko naya reward dikhega.</div>
        </div>

        <div class="support-item" onclick="toggleTopic(this)">
          <div class="support-q"><i class="ti ti-plus support-icon"></i> App slow hai ya kaam nahi kar raha</div>
          <div class="support-a">Page refresh karo (pull down on mobile). Internet connection check karo. Agar phir bhi problem hai toh WhatsApp pe screenshot bhejo — hum jaldi fix karenge.</div>
        </div>

      </div>
    </div>
  </div>

</div><!-- end k-page -->

<script> 
/* =========================
   SESSION CHECK
========================= */
const BASE_URL = "https://keepl.onrender.com";
const token = localStorage.getItem("token");
const shopIdLocal = localStorage.getItem("shopId");
const SHOP_NAME = "<%= shop.name %>";
let REWARD_THRESHOLD = <%= shop.rewardThreshold || 100 %>;

if(!token || !shopIdLocal){
  window.location.href="/";
}

/* =========================
   STATE
========================= */

let isFetching = false;
let lastTransactionTime = 0;
let activeInputPhone = null;
let inputCache = {};

// Dismissed search results
const dismissedPhones = new Set();


/* =========================
   QUEUE PING SOUND
========================= */

function playQueuePing(){
  try{
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.type = "sine";
    osc.frequency.setValueAtTime(880, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.2);

    gain.gain.setValueAtTime(0.3, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);

    osc.start(ctx.currentTime);
    osc.stop(ctx.currentTime + 0.4);
  }catch(e){
    console.error("Audio not available:", e);
  }
}

// Expiry tracking
let previousQueuePhones = new Set();
let lastQueueNames = {};
const recentlyProcessed = new Set();

/* =========================
   LOGOUT
========================= */

function logout(){
  if(confirm("Logout?")){
    localStorage.clear();
    window.location.href="/";
  }
}

/* =========================
   SAFE TEXT
========================= */

function safe(text){
  return String(text)
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;");
}

/* =========================
   TOAST — expiry alert
========================= */

function showToast(message){
  const container = document.getElementById("toastContainer");
  const toast = document.createElement("div");
  toast.className = "toast";
  toast.innerText = message;
  container.appendChild(toast);

  setTimeout(()=> toast.classList.add("fadeout"), 4800);
  setTimeout(()=> toast.remove(), 5200);
}

/* =========================
   WHATSAPP — points earned
========================= */

function sendWhatsApp(phone, customerName, pointsEarned, totalPoints, amountSpent){

  const cleanPhone = String(phone).replace(/\D/g,"").slice(-10);

  const message =
    `Hi ${customerName}! 🎉\n\n` +
    `Thank you for visiting *${SHOP_NAME}*.\n\n` +
    `🧾 Amount Spent: ₹${amountSpent}\n` +
    `⭐ Points Earned: *${pointsEarned} pts*\n` +
    `🏆 Total Points: *${totalPoints} pts*\n\n` +
    `${totalPoints >= REWARD_THRESHOLD ? "🎉 Congratulations! You have collected *" + totalPoints + " points*! You can now redeem your points for a free reward! Tell the shopkeeper 🎁" : "🎁 Collect *" + REWARD_THRESHOLD + " points* to redeem a free reward!"}\n\n` +
    `See you again soon 😊\n` +
    `– ${SHOP_NAME} via Keepl`;

  const waUrl = `https://wa.me/91${cleanPhone}?text=${encodeURIComponent(message)}`;
  const waWindow = window.open(waUrl, "_blank");

  // ✅ Fallback — if WhatsApp didn't open, show message to copy
  setTimeout(() => {
    if(!waWindow || waWindow.closed || typeof waWindow.closed === "undefined"){
      showWaFallback(phone, message);
    }
  }, 2000);
}

function showWaFallback(phone, message){
  const existing = document.getElementById("wa-fallback-modal");
  if(existing) existing.remove();

  const modal = document.createElement("div");
  modal.id = "wa-fallback-modal";
  modal.style.cssText = `
    position:fixed;top:0;left:0;right:0;bottom:0;
    background:rgba(26,26,46,0.6);z-index:9999;
    display:flex;align-items:center;justify-content:center;padding:20px;
  `;

  modal.innerHTML = `
    <div style="background:#fff;border-radius:20px;padding:28px;max-width:420px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
        <div style="width:36px;height:36px;background:#E8FFF3;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;">📲</div>
        <div>
          <div style="font-size:15px;font-weight:500;color:var(--k-ink);">WhatsApp didn't open</div>
          <div style="font-size:12px;color:var(--k-ink-tertiary);">Copy and send this message manually</div>
        </div>
        <button onclick="document.getElementById('wa-fallback-modal').remove()" style="margin-left:auto;background:none;border:none;font-size:20px;cursor:pointer;color:var(--k-ink-tertiary);width:auto;padding:4px;">✕</button>
      </div>
      <div style="background:var(--k-bg);border:0.5px solid var(--k-border);border-radius:12px;padding:14px;font-size:13px;color:var(--k-ink-secondary);line-height:1.7;white-space:pre-wrap;max-height:200px;overflow-y:auto;">\${message}</div>
      <div style="display:flex;gap:10px;margin-top:16px;">
        <button
          onclick="navigator.clipboard.writeText(message).then(()=>{ this.innerText='Copied!'; setTimeout(()=>{ this.innerHTML='<i class=\'ti ti-copy\'></i> Copy message'; },2000); })"
          style="flex:1;background:var(--k-saffron);color:#fff;border:none;padding:11px;border-radius:12px;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;">
          <i class="ti ti-copy"></i> Copy message
        </button>
        <a href="https://wa.me/91\${phone}" target="_blank"
          style="flex:1;background:#E8FFF3;color:#065F46;border:none;padding:11px;border-radius:12px;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;">
          📲 Try WhatsApp
        </a>
      </div>
    </div>
  `;

  modal.addEventListener("click", (e) => {
    if(e.target === modal) modal.remove();
  });

  document.body.appendChild(modal);
}

